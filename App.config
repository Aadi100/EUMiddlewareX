<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings>
	<add name="SmartAttendance" connectionString="Server=localhost\SQLEXPRESS;Database=SmartAttendance;Integrated Security=True;" />
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
      <provider invariantName="System.Data.SQLite.EF6" type="System.Data.SQLite.EF6.SQLiteProviderServices, System.Data.SQLite.EF6" />
    </providers>
  </entityFramework>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Data.SQLite" publicKeyToken="db937bc2d4491ea3" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.0.118.0" newVersion="1.0.118.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Data.SQLite.SEE" publicKeyToken="0a9a2a02614f8a52" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.0.119.0" newVersion="1.0.119.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <appSettings>
    <add key="BackupEmailEnabled" value="true" />
    <add key="SmtpHost" value="smtp.gmail.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUser" value="aabdul.hadikhan10@gmail.com" />
    <!-- Use a Gmail App Password (not your regular password) -->
    <add key="SmtpPassword" value="rdnjphwitxyeqdlr" />
    <add key="BackupEmailTo" value="aaddiiiii10@gmail.com" />
    <!-- Adjust these paths to where you actually write logs -->
    <add key="CrashLogPath" value="D:\SmartAttendanceMiddleware\bin\x86\Debug\Crash.log" />
    <add key="MiddlewareLogPath" value="D:\SmartAttendanceMiddleware\bin\x86\Debug\Middlewarelog.txt" />
    <add key="GoogleDriveFolderId" value="BACKUP" />
  </appSettings>
</configuration>
